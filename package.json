    "framer-motion": "^12.23.12",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.10.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "^0.179.0",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.3",
    "postcss": "^8.4.49",
    "sass": "^1.83.0",
    "serve": "14.2.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
