{
  "name": "the-nihongo-vibes",
  "version": "61.0.0",
  "private": true,
  "scripts": {
    "data:build": "python scripts/build_klc_from_csv.py && python scripts/build_data.py",
    "dev": "npm run data:build && next dev",
    "build": "npm run data:build && next build",
    "vercel-build": "next build",
    "start": "serve out",
    "lint": "eslint . --max-warnings=0",
    "lint:types": "tsc --noEmit",
    "qa": "python scripts/qa_production.py",
    "test:e2e": "node scripts/stage_e2e.mjs && playwright test",
    "verify": "npm run lint:types && npm run lint && npm run qa",
    "build:sw": "python scripts/build_sw.py out",
    "repo:hygiene": "python scripts/repo_hygiene.py"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
